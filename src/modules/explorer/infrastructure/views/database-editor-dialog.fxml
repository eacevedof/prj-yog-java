<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import modules.shared.infrastructure.components.icons.AppIcon?>

<!-- el "Alter Database" (MySQL/MariaDB): las opciones que cambia un ALTER DATABASE y el SQL que se va a ejecutar; las
     que el servidor no da salen desactivadas -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="620" prefHeight="440" spacing="8"
      styleClass="copy-dialog" fx:controller="modules.explorer.infrastructure.controllers.DatabaseEditorDialogController">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <AppIcon name="database"/>
        <Label text="%Base de datos" styleClass="copy-section"/>
        <Label fx:id="databaseNameLabel" styleClass="active-database"/>
    </HBox>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="170"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%Juego de caracteres" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="characterSetComboBox" maxWidth="Infinity" visibleRowCount="20" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%Cotejamiento" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="collationComboBox" maxWidth="Infinity" visibleRowCount="20" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%Cifrado por defecto" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <CheckBox fx:id="encryptionCheckBox" text="%Tablas nuevas cifradas (ENCRYPTION)" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%Solo lectura" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <CheckBox fx:id="readOnlyCheckBox" text="%Nadie puede escribir en la BD (READ ONLY)" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="%Comentario" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="commentField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>
    <Label text="%El juego de caracteres y el cotejamiento son los de las tablas nuevas: las que ya existen no cambian." wrapText="true" styleClass="query-status"/>
    <Label text="%SQL que se va a ejecutar" styleClass="copy-section"/>
    <TextArea fx:id="sqlTextArea" editable="false" wrapText="true" styleClass="result-text" VBox.vgrow="ALWAYS"/>
    <Label fx:id="statusLabel" wrapText="true" styleClass="query-status"/>
    <HBox styleClass="toolbar-buttons" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="%Guardar" defaultButton="true" onAction="#onSave">
            <graphic><AppIcon name="save"/></graphic>
        </Button>
        <Button fx:id="closeButton" text="%Cancelar" cancelButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
