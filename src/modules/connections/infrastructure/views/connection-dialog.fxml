<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import modules.shared.infrastructure.components.icons.AppIcon?>

<!-- alta/edicion de una conexion: una pestaña por forma de llegar a la BD (directa, tunel SSH, tunel HTTP) -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="480"
      fx:controller="modules.connections.infrastructure.controllers.ConnectionDialogController">
    <TabPane fx:id="connectionTabPane" tabClosingPolicy="UNAVAILABLE">
        <Tab fx:id="mysqlTab" text="%Conexión">
            <graphic><AppIcon name="database"/></graphic>
            <GridPane styleClass="dialog-form">
                <Label text="%Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="connectionNameField" promptText="%prod-mi-app" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="%Motor" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="dbEngineComboBox" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="%Host" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="hostField" promptText="127.0.0.1" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="%Puerto" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="portField" promptText="3306" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="%Usuario" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="userNameField" promptText="%root" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="%Password" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <PasswordField fx:id="userPasswordField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label fx:id="databaseNameLabel" text="%Base de datos" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <HBox spacing="6" GridPane.rowIndex="6" GridPane.columnIndex="1">
                    <TextField fx:id="databaseNameField" promptText="%(opcional)" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="sqliteFileButton" text="..." onAction="#onChooseSqliteFile" visible="false" managed="false"/>
                </HBox>

                <Label text="%Color" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <HBox spacing="8" GridPane.rowIndex="7" GridPane.columnIndex="1">
                    <CheckBox fx:id="useColorCheckBox" text="%usar color"/>
                    <ColorPicker fx:id="colorPicker"/>
                </HBox>

                <Label text="%Producción" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <CheckBox fx:id="isProductionCheckBox" text="%pedir confirmación en sentencias peligrosas"
                          GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                <Label fx:id="tunnelSummaryLabel" wrapText="true" maxWidth="440" minHeight="-Infinity" styleClass="query-status"
                       GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
            </GridPane>
        </Tab>
        <Tab fx:id="sshTab" text="%SSH">
            <graphic><AppIcon name="key"/></graphic>
            <GridPane styleClass="dialog-form">
                <CheckBox fx:id="sshEnabledCheckBox" text="%conectar a través de un túnel SSH"
                          GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

                <Label text="%Host SSH" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="sshHostField" promptText="%servidor.ejemplo.com" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="%Puerto SSH" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="sshPortField" promptText="22" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="%Usuario SSH" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="sshUserField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="%Password SSH" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <PasswordField fx:id="sshPasswordField" promptText="%(o clave privada)" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="%Clave privada" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <HBox spacing="6" GridPane.rowIndex="5" GridPane.columnIndex="1">
                    <TextField fx:id="sshPrivateKeyPathField" promptText="%C:\Users\yo\.ssh\id_ed25519" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="sshPrivateKeyButton" text="..." onAction="#onChoosePrivateKey"/>
                </HBox>

                <Label text="%Passphrase" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <PasswordField fx:id="sshPassphraseField" promptText="%(si la clave la tiene)" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="%Con túnel, Host y Puerto de la pestaña Conexión son la BD vista desde el servidor SSH (normalmente 127.0.0.1 y 3306)."
                       wrapText="true" maxWidth="440" styleClass="query-status"
                       GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
            </GridPane>
        </Tab>
        <Tab fx:id="httpTab" text="%HTTP">
            <graphic><AppIcon name="globe"/></graphic>
            <GridPane styleClass="dialog-form">
                <CheckBox fx:id="httpEnabledCheckBox" text="%conectar a través de un túnel HTTP (PHP)"
                          GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

                <Label text="%URL" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="httpUrlField" promptText="%https://yog.ejemplo.com/&lt;token&gt;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="%Timeout (s)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="httpTimeoutField" promptText="30" maxWidth="80" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="%El túnel es el PHP de prj-yog (protocolo de SQLyog 13.21). La URL lleva el token de acceso: se guarda cifrada y no se vuelve a mostrar. Host y Puerto de la pestaña Conexión son la BD vista desde ese servidor. Con PostgreSQL, la URL va igual: multidbs añade /pg."
                       wrapText="true" maxWidth="440" styleClass="query-status"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
            </GridPane>
        </Tab>
    </TabPane>
    <Label fx:id="messageLabel" wrapText="true" maxWidth="460" minHeight="-Infinity" styleClass="dialog-message"/>
    <HBox styleClass="toolbar-buttons" alignment="CENTER_RIGHT">
        <Button fx:id="testButton" text="%Probar conexión" onAction="#onTestConnection"/>
        <Button text="%Cancelar" cancelButton="true" onAction="#onCancel"/>
        <Button text="%Guardar" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
