<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import modules.shared.infrastructure.components.icons.AppIcon?>

<!-- una conexion abierta: la BD activa y las pestañas de query; su arbol de objetos va bajo la conexion en el panel.
     A la derecha, como los iconos de SQLyog: volcado SQL (MySQL) y ejecutar un fichero .sql en la BD activa -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="modules.workspace.infrastructure.controllers.ConnectionTabController">
    <top>
        <HBox styleClass="active-database-bar" alignment="CENTER_LEFT" spacing="4">
            <Label text="%BD activa:"/>
            <ComboBox fx:id="activeDatabaseComboBox" prefWidth="240" visibleRowCount="20"><tooltip><Tooltip text="%Elegir la BD activa (escribe para buscar)"/></tooltip></ComboBox>
            <Label fx:id="systemDatabaseWarningLabel" text="%BD de sistema" styleClass="system-database-warning" visible="false" managed="false"><graphic><AppIcon name="warning"/></graphic><tooltip><Tooltip text="%La BD activa es del propio servidor: cuidado al escribir en ella"/></tooltip></Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="filesStatusLabel" styleClass="query-status" visible="false" managed="false"/>
            <Button fx:id="saveFilesButton" text="%Guardar en ficheros" minWidth="-Infinity" onAction="#onSaveFiles" visible="false" managed="false">
                <graphic><AppIcon name="save"/></graphic>
                <tooltip><Tooltip text="%Escribe en su fichero cada tabla que ha cambiado; una tabla nueva, como .csv"/></tooltip>
            </Button>
            <Button fx:id="reloadFilesButton" text="%Recargar ficheros" minWidth="-Infinity" onAction="#onReloadFiles" visible="false" managed="false">
                <graphic><AppIcon name="refresh"/></graphic>
                <tooltip><Tooltip text="%Vuelve a leer todos los ficheros de la carpeta (se pierde lo no guardado)"/></tooltip>
            </Button>
            <Button fx:id="exportSqlDumpButton" text="%Exportar" minWidth="-Infinity" onAction="#onExportSqlDump">
                <graphic><AppIcon name="database-export"/></graphic>
                <tooltip><Tooltip text="%Volcado SQL de la BD activa (exportar a .sql)"/></tooltip>
            </Button>
            <Button text="%Importar" minWidth="-Infinity" onAction="#onExecuteSqlFile">
                <graphic><AppIcon name="database-import"/></graphic>
                <tooltip><Tooltip text="%Ejecutar un fichero .sql en la BD activa (importar)"/></tooltip>
            </Button>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="queryTabPane" tabClosingPolicy="ALL_TABS" tabDragPolicy="REORDER"/>
    </center>
</BorderPane>
