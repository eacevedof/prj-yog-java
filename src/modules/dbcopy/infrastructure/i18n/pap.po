msgstr "entre motor diferente ta kopia so e tabelnan (e vista, rutina, trigger i evento no ta wòrdu tradusí)"

msgid "SQLite has a single database (main): {0} cannot be created"
msgstr "SQLite tin un BD so (main): no por kreá {0}"

