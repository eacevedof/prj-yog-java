msgid "Copying only works between SQL engines (MySQL/MariaDB, PostgreSQL, SQL Server, SQLite): {0} is {1}"
msgstr "Kopiëren werkt alleen tussen SQL-engines (MySQL/MariaDB, PostgreSQL, SQL Server, SQLite): {0} is {1}"

msgid "between different engines only tables are copied (views, routines, triggers and events are not translated)"
msgstr "tussen verschillende engines worden alleen tabellen gekopieerd (views, routines, triggers en events worden niet vertaald)"

msgid "SQLite has a single database (main): {0} cannot be created"
msgstr "SQLite heeft één database (main): {0} kan niet worden aangemaakt"

msgid "value {0} is not valid for column {1} ({2})"
msgstr "waarde {0} is niet geldig voor kolom {1} ({2})"

msgid "index {0} not created: {1}"
msgstr "index {0} niet aangemaakt: {1}"

msgid "Entre motores distintos solo se copian las tablas (tipos traducidos, clave primaria, índices y datos)."
msgstr "Tussen verschillende engines worden alleen tabellen gekopieerd (vertaalde types, primaire sleutel, indexen en gegevens)."

msgid "Renombrando: espera a que acabe, no se puede parar a medias"
msgstr "Hernoemen: wacht tot het klaar is, het kan niet halverwege worden gestopt"
