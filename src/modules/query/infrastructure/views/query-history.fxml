<?xml version="1.0" encoding="UTF-8"?>

<?import modules.shared.infrastructure.components.icons.AppIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- historial de queries (feature 8), pestaña del resultado: rejilla arriba (id desc, ordenable) y SQL completo abajo -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="modules.query.infrastructure.controllers.QueryHistoryController">
    <HBox styleClass="toolbar-buttons" alignment="CENTER_LEFT">
        <Button text="%Refrescar" minWidth="-Infinity" contentDisplay="GRAPHIC_ONLY" onAction="#onRefresh"><graphic><AppIcon name="refresh"/></graphic><tooltip><Tooltip text="%Volver a leer el historial (F5): lo lanzado desde el árbol (DROP, duplicar...) aparece al refrescar"/></tooltip></Button>
        <TextField fx:id="searchField" promptText="%Buscar en el SQL" HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="onlyThisConnectionCheckBox" text="%Solo esta conexión" selected="true"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS">
        <TableView fx:id="historyTableView">
            <columns>
                <TableColumn fx:id="idColumn" text="%ID" prefWidth="60"/>
                <TableColumn fx:id="executedAtColumn" text="%Fecha" prefWidth="140"/>
                <TableColumn fx:id="connectionColumn" text="%Conexión" prefWidth="120"/>
                <TableColumn fx:id="databaseColumn" text="%BD" prefWidth="100"/>
                <TableColumn fx:id="elapsedColumn" text="%ms" prefWidth="60"/>
                <TableColumn fx:id="rowsColumn" text="%Filas" prefWidth="60"/>
                <TableColumn fx:id="sqlColumn" text="%SQL" prefWidth="500"/>
            </columns>
        </TableView>
        <TextArea fx:id="sqlTextArea" editable="false" styleClass="result-text"/>
    </SplitPane>
    <HBox styleClass="toolbar-buttons" alignment="CENTER_LEFT">
        <Label fx:id="countLabel" styleClass="query-status"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="pasteButton" text="%Pegar en el editor" onAction="#onPaste"><graphic><AppIcon name="paste"/></graphic></Button>
        <Button text="%Copiar" onAction="#onCopy"><graphic><AppIcon name="copy"/></graphic></Button>
        <Button text="%Exportar SQL" onAction="#onExportSql"><graphic><AppIcon name="database-export"/></graphic><tooltip><Tooltip text="%Lo que se ve, en orden de ejecución, para volver a lanzarlo con Importar"/></tooltip></Button>
        <Button fx:id="clearButton" text="%Limpiar historial" onAction="#onClear"><graphic><AppIcon name="delete"/></graphic></Button>
    </HBox>
</VBox>
